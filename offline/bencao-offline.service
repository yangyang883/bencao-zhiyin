[Unit]
Description=Bencao offline image and speech service
After=nvargus-daemon.service

[Service]
User=jetson
WorkingDirectory=/home/jetson/bencao-offline-20260924
Environment=BENCAO_CSI=1
Environment=BENCAO_MODEL_DEVICE=cpu
ExecStart=/usr/bin/python3 /home/jetson/bencao-offline-20260924/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
